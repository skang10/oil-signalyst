# API keys
EIA_API_KEY=your_eia_key_here
FRED_API_KEY=your_fred_key_here
TABPFN_API_KEY=your_tabpfn_client_token_here
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o

# Optional. If omitted, the app uses data/oilmarket.db under the resolved repo/app root.
# DB_URL=sqlite+aiosqlite:////absolute/path/to/oilmarket.db

# Auth. jwt_secret needs 32+ random bytes in any shared/deployed setting;
# default_user_password seeds the one local account on first run.
JWT_SECRET=dev-only-insecure-default-secret-change-me-32bytes
DEFAULT_USER_PASSWORD=oilsignalyst

# Environment
ENV=local
LOG_LEVEL=INFO

# Scheduler
SCHEDULER_ENABLED=true
PIPELINE_CRON_HOUR=22
PIPELINE_CRON_MINUTE=0
